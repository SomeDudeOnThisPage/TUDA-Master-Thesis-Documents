	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/fld.1362},
	doi = {10.1002/fld.1362},
	abstract = {The ability of automatically reconstructing physiological shapes, of generating computational meshes, and of calculating flow solutions from medical images is enabling the introduction of computational fluid dynamics (CFD) techniques as an additional tool to aid clinical practice. This article presents a set of procedures for the shape reconstruction and triangulation of geometries derived from a set of medical images representing planar cross sections of the object. The reconstruction of the shape of the boundary is based on the interpolation of an implicit function through a set of points obtained from the segmentation of the images. This approach is favoured for its ability of smoothly interpolating between sections of different topology. The boundary of the object is an iso-surface of the implicit function that is approximated by a triangulation extracted by the method of marching cubes. The quality of this triangulation is often neither suitable for mesh generation nor for flow solution. We discuss the use of mesh enhancement techniques to maximize the quality of the triangulation together with curvature adaption to optimize mesh resolution. The proposed methodology is applied to the reconstruction and discretization of two physiological geometries: a femoral by-pass graft and a nasal cavity. Copyright © 2006 John Wiley \& Sons, Ltd.},
	language = {en},
	number = {8},
	urldate = {2025-01-09},
	journal = {International Journal for Numerical Methods in Fluids},
	author = {Peiró, J. and Formaggia, L. and Gazzola, M. and Radaelli, A. and Rigamonti, V.},
	year = {2007},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/fld.1362},
	keywords = {implicit surfaces, medical image processing, mesh enhancement, mesh generation, radial basis functions, shape reconstruction},
	pages = {1339--1360},
	file = {Full Text PDF:C\:\\Users\\robin\\Zotero\\storage\\LHM4VVCF\\Peiró et al. - 2007 - Shape reconstruction from medical images and quality mesh generation via implicit surfaces.pdf:application/pdf;Snapshot:C\:\\Users\\robin\\Zotero\\storage\\L4L4255Y\\fld.html:text/html},
}

@article{zhou_novel_2017,
	title = {A novel {3D} geometrical reconstruction model for porous rocks},
	volume = {228},
	issn = {0013-7952},
	url = {https://www.sciencedirect.com/science/article/pii/S0013795217306919},
	doi = {10.1016/j.enggeo.2017.08.021},
	abstract = {In this paper, a novel geometrical reconstruction model is proposed for numerical simulation of pore structure in rocks. The spatial configuration and geometrical information of the microstructure are firstly gathered from Chongqing sandstone by X-ray micro-CT observations, and experimental tests on Chongqing sandstone are applied to obtain the mechanical parameters. Then, on the basis of the gathered geometrical information, the surface geometrical model is established by using the modified Marching cubes algorithm. Next, the established surface geometrical model is extended to 3D tetrahedral model by using Delaunay refinement algorithm. Finally, the 3D tetrahedral model is transformed into finite element (FE) numerical model. Moreover, the relationship between the porosity, fractal dimension of pore structure and mechanical properties of Chongqing sandstone is also investigated. The comparison of the numerical results and the experimental data shows a good consistency.},
	urldate = {2025-01-09},
	journal = {Engineering Geology},
	author = {Zhou, Xiao-Ping and Xiao, Nan},
	month = oct,
	year = {2017},
	keywords = {Porous media, Delaunay refinement algorithm, Pore-matrix interface extraction, The surface reconstruction, 3D numerical analysis},
	pages = {371--384},
	file = {ScienceDirect Snapshot:C\:\\Users\\robin\\Zotero\\storage\\Z8LMJ9MF\\S0013795217306919.html:text/html},
}

