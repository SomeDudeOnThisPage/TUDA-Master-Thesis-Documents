@article{fagbemi_interaction_2018,
	title = {Interaction {Between} {Fluid} and {Porous} {Media} with {Complex} {Geometries}: {A} {Direct} {Pore}-{Scale} {Study}},
	volume = {54},
	copyright = {©2018. American Geophysical Union. All Rights Reserved.},
	issn = {1944-7973},
	shorttitle = {Interaction {Between} {Fluid} and {Porous} {Media} with {Complex} {Geometries}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1029/2017WR022242},
	doi = {10.1029/2017WR022242},
	abstract = {Effect of boundary stress on permeability in porous media at pore-scale is investigated by means of numerical methods for computing deformation of rock material in the presence of pore fluid. We implement a partitioned, strongly coupled solver for transient fluid-solid simulations with independent conformed interface meshes for the fluid and solid domains. Fluid flow and solid computations were performed using the finite element method. External load is prescribed along the solid boundary in gradual steps to examine the extent of pore-scale deformation along internal grain walls while applying a fixed constraint at the opposite end to ensure uniform stress distribution across the media. Hydrodynamic interactions between the pore walls and the matrix leading to interface displacements by fluid viscous forces are also investigated by examining fluid flow with different combinations of Reynolds number. Coupling is achieved via traction and displacements boundary conditions at the interface with respect to Lagrangian coordinates. The role of particle shape in the matrix deformation process is also considered in this paper. In order to examine the how particle shape affects local affects local permeability/stress, we examine fluid movement based on varying Reynolds numbers in Berea sandstone obtained from Micro-CT image scans at high resolution, and artificially constructed random polydisperse 3-D sphere packs. It was found that permeability alteration under the influence of uniaxial stress was more in the sandstone sample than in the sphere-pack and that the sphere-pack deformed less than the actual sample due to pore geometry, surface smoothness, and homogeneity.},
	language = {en},
	number = {9},
	urldate = {2025-01-09},
	journal = {Water Resources Research},
	author = {Fagbemi, Samuel and Tahmasebi, Pejman and Piri, Mohammad},
	year = {2018},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1029/2017WR022242},
	keywords = {CO2 sequestration, deformation, enhanced oil recovery, faulting, fluid injection, fluid-rock},
	pages = {6336--6356},
	file = {Full Text PDF:C\:\\Users\\robin\\Zotero\\storage\\BMV6PQEV\\Fagbemi et al. - 2018 - Interaction Between Fluid and Porous Media with Complex Geometries A Direct Pore-Scale Study.pdf:application/pdf;Snapshot:C\:\\Users\\robin\\Zotero\\storage\\7DEB6AM7\\2017WR022242.html:text/html},
}

